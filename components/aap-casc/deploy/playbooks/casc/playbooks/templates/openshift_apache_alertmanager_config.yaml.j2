---
apiVersion: v1
kind: Secret
metadata:
  name: otel-webhook-auth
  namespace: {{ openshift_apache_monitoring_namespace | default(vm_namespace | default('aiops-demo')) }}
  labels:
    app.kubernetes.io/part-of: observability
type: Opaque
stringData:
  ALERTMANAGER_USERNAME: "{{ observability.otel_webhook.alertmanager_username }}"
  ALERTMANAGER_PASSWORD: "{{ observability.otel_webhook.alertmanager_password }}"
---
apiVersion: monitoring.coreos.com/v1alpha1
kind: AlertmanagerConfig
metadata:
  name: otel-webhook
  namespace: {{ openshift_apache_monitoring_namespace | default(vm_namespace | default('aiops-demo')) }}
  labels:
    app.kubernetes.io/part-of: observability
spec:
  route:
    receiver: otel-collector
    groupBy:
      - alertname
    groupWait: 10s
    groupInterval: 30s
    repeatInterval: 4h
  receivers:
    - name: otel-collector
      webhookConfigs:
        - url: http://otel-collector-upstream.{{ observability.namespace }}.svc:8090/v1/alerts
          sendResolved: true
          httpConfig:
            basicAuth:
              username:
                name: otel-webhook-auth
                key: ALERTMANAGER_USERNAME
              password:
                name: otel-webhook-auth
                key: ALERTMANAGER_PASSWORD
