# Session and MCP auth
SESSION_SECRET={{ itsm.session_secret }}
SESSION_MAX_AGE_SECONDS={{ itsm.session_max_age_seconds }}
MCP_TOKEN={{ itsm.mcp_token }}

# First admin when the database is empty. Leave empty to skip bootstrap.
ITSM_BOOTSTRAP_ADMIN_USER={{ itsm.bootstrap_admin_user }}
ITSM_BOOTSTRAP_ADMIN_PASSWORD={{ itsm.bootstrap_admin_password }}

# Default automation user (aiops) seeded on first startup. Leave empty to skip.
ITSM_SEED_AIOPS_PASSWORD={{ itsm.seed_aiops_password }}

# KB semantic search (MCP rag_search_kb). Origin only; app calls {BASE}/v1/embeddings.
ITSM_EMBEDDING_BASE_URL={{ itsm.embedding_base_url }}
ITSM_EMBEDDING_MODEL={{ itsm.embedding_model }}
ITSM_EMBEDDING_API_KEY={{ itsm.embedding_api_key }}

# Data paths
ITSM_DATABASE=/data/itsm.db
ITSM_UPLOAD_DIR=/data/uploads
ITSM_KB_REPO=/app/kb-repo
ITSM_KB_REPO_URL={{ itsm.kb_repo_url }}
ITSM_KB_REPO_PATH={{ itsm.kb_repo_path }}
