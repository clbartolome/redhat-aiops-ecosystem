# LLM (required)
LLM_URL={{ agent.llm_url }}
LLM_API_KEY={{ agent.llm_api_key }}
LLM_MODEL={{ agent.llm_model }}
LLM_TIMEOUT={{ agent.llm_timeout }}
# LLM_MAX_TOKENS=1024

# MCP servers
OPENSHIFT_MCP_URL={{ agent.openshift_mcp_url }}
ITSM_MCP_URL={{ agent.itsm_mcp_url }}
ITSM_MCP_TOKEN={{ agent.itsm_mcp_token }}
TOOLS_TIMEOUT={{ agent.tools_timeout }}

# Shared / agent
SSL_VERIFY={{ agent.ssl_verify | string | lower }}
LOG_LEVEL={{ agent.log_level }}
TRACE_DB_PATH={{ agent.trace_db_path }}
