# LLM (required)
MODEL_NAME={{ agent.model_name }}
MODEL_BASE_URL={{ agent.model_base_url }}
MODEL_API_KEY={{ agent.model_api_key }}

# OpenShift MCP
OPENSHIFT_MCP_URL={{ agent.openshift_mcp_url }}
OPENSHIFT_MCP_TOKEN={{ agent.openshift_mcp_token | default('') }}
OPENSHIFT_MCP_TLS_VERIFY={{ agent.openshift_mcp_tls_verify | string | lower }}
OPENSHIFT_MCP_ALLOWED_TOOLS={{ agent.openshift_mcp_allowed_tools }}

# AAP MCP
AAP_MCP_URL={{ agent.aap_mcp_url }}
AAP_MCP_TOKEN={{ agent.aap_mcp_token }}
AAP_MCP_TLS_VERIFY={{ agent.aap_mcp_tls_verify | string | lower }}
AAP_MCP_ALLOWED_TOOLS={{ agent.aap_mcp_allowed_tools }}

# ITSM MCP
ITSM_MCP_URL={{ agent.itsm_mcp_url }}
ITSM_MCP_TOKEN={{ agent.itsm_mcp_token }}
ITSM_MCP_TLS_VERIFY={{ agent.itsm_mcp_tls_verify | string | lower }}
ITSM_MCP_ALLOWED_TOOLS={{ agent.itsm_mcp_allowed_tools }}
