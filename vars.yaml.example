---
# Copy to vars.yaml and replace every <...> placeholder.
#   cp vars.yaml.example vars.yaml
#
# Do not commit vars.yaml (it is gitignored).
# Cluster credentials: pass ocp_host and api_token at runtime with -e, not here.

# Standard demo admin password for Argo CD, ITSM, Grafana, and Gitea.
demo_admin_password: redhat1q2w3e

kubeconfig:
  ocp_domain: "{{ ocp_host }}"
  ocp_api_token: "{{ api_token }}"

openshift_mcp:
  namespace: openshift-mcp

aap_mcp:
  namespace: aap
  instance_name: ansible
  allow_write_operations: true
  ignore_certificate_errors: true
  port: 8086
  url: ""
  token: ""
  token_description: aiops-mcp-agent
  token_scope: write
  token_secret_name: aap-mcp-agent-token
  validate_certs: false
  # Set true after AAP reset to force a fresh gateway OAuth token.
  recreate_token_on_install: false
  # Refresh agent-config and restart the agent after MCP token changes.
  sync_agent_token: true
  # Validate gateway auth and MCP initialize handshake during install.
  test_connectivity: true
  token_probe_retries: 12
  token_probe_delay: 10
  mcp_probe_retries: 12
  mcp_probe_delay: 10
  agent_rollout_wait_retries: 30
  agent_rollout_wait_delay: 10

aap_eda:
  namespace: aap
  instance_name: ansible
  automation_server_ssl_verify: "no"
  postgres_pod_label_selector: app.kubernetes.io/name=postgres-15,app.kubernetes.io/part-of=ansible
  postgres_admin_secret: ansible-gateway-postgres-configuration
  postgres_admin_password_key: postgres_admin_password
  database_name: eda
  database_owner: eda
  # Leave false for re-runs; set true only for a deliberate EDA database reset.
  reset_database_on_install: false

gitops:
  namespace: openshift-gitops
  instance_name: openshift-gitops
  admin_user: admin
  admin_password: "{{ demo_admin_password }}"
  session_duration: 1h

itsm:
  namespace: itsm-app
  image: quay.io/rhn_support_rafsanch/itsm-app:v2.2
  session_secret: <replace-with-long-random-string>
  mcp_token: <your-itsm-mcp-token>
  bootstrap_admin_user: admin
  bootstrap_admin_password: "{{ demo_admin_password }}"
  seed_aiops_password: "{{ demo_admin_password }}"
  session_max_age_seconds: 3600
  embedding_base_url: <your-embedding-api-base-url>
  embedding_model: <your-embedding-model>
  embedding_api_key: <your-embedding-api-key>
  kb_repo_url: https://github.com/clbartolome/redhat-aiops-ecosystem
  kb_repo_path: components/itsm/kbs

gitea:
  namespace: gitea
  host: "gitea-gitea.apps.{{ ocp_host }}"
  root_url: "https://gitea-gitea.apps.{{ ocp_host }}/"
  gitea_image: quay.io/rhn_support_rafsanch/gitea:1.24-rootless
  postgres_image: quay.io/rhn_support_rafsanch/postgres:16-alpine
  secret_key: <openssl-rand-hex-32>
  admin_user: giteaadmin
  admin_password: "{{ demo_admin_password }}"
  admin_email: admin@example.com
  session_max_age_seconds: 3600
  postgres_user: gitea
  postgres_password: <your-postgres-password>
  postgres_db: gitea

agent:
  namespace: aiops-tools
  manifest_apply_retries: 5
  manifest_apply_delay: 15
  image: quay.io/calopezb/aiops-agent:1.0
  # Requires SQLite >= 3.35 in the agent image (openai-agents SQLiteSession uses RETURNING).
  # Optional override; do not use agent.namespace inside this block (Ansible recursive template loop).
  # incidents_url: http://agent.aiops-tools.svc.cluster.local:8080/incidents
  model_name: <your-model-name>
  model_base_url: <your-llm-base-url>
  model_api_key: <your-llm-api-key>
  # kubernetes-mcp-server streamable HTTP endpoint (no trailing slash; /mcp/ returns 404)
  openshift_mcp_url: http://openshift-mcp-server.{{ openshift_mcp.namespace }}.svc.cluster.local:8080/mcp
  openshift_mcp_token: ""
  openshift_mcp_tls_verify: false
  openshift_mcp_allowed_tools: >-
    mcp_openshift__namespaces_list,mcp_openshift__pods_get,mcp_openshift__pods_list,mcp_openshift__pods_list_in_namespace,mcp_openshift__pods_log,mcp_openshift__projects_list,mcp_openshift__resources_get,mcp_openshift__resources_list
  aap_mcp_url: "{{ aap_mcp.url | default('http://' ~ aap_mcp.instance_name ~ '-mcp.' ~ aap_mcp.namespace ~ '.svc.cluster.local:' ~ (aap_mcp.port | default(8086) | string) ~ '/mcp/', true) }}"
  aap_mcp_token: "{{ aap_mcp.token }}"
  aap_mcp_tls_verify: false
  aap_mcp_allowed_tools: >-
    mcp_aap__job_templates_launch_create,mcp_aap__job_templates_list,mcp_aap__job_templates_retrieve,mcp_aap__jobs_list,mcp_aap__jobs_retrieve,mcp_aap__jobs_stdout_retrieve,mcp_aap__workflow_job_templates_launch_create,mcp_aap__workflow_job_templates_list,mcp_aap__workflow_job_templates_retrieve,mcp_aap__workflow_jobs_list,mcp_aap__workflow_jobs_retrieve
  itsm_mcp_url: http://itsm-app.{{ itsm.namespace }}.svc.cluster.local:8000/mcp/
  itsm_mcp_token: "{{ itsm.mcp_token }}"
  itsm_mcp_tls_verify: false
  itsm_mcp_allowed_tools: >-
    mcp_itsm__create_request,mcp_itsm__get_incident,mcp_itsm__get_kb_article,mcp_itsm__get_request,mcp_itsm__get_request_template,mcp_itsm__list_incidents,mcp_itsm__list_request_templates,mcp_itsm__list_requests,mcp_itsm__rag_search_kb,mcp_itsm__search_kb

observability:
  namespace: observability
  monitoring_stack_name: observability
  # Use 2+ only when you have enough nodes for Alertmanager pod anti-affinity.
  alertmanager_replicas: 1
  kafka_cluster_name: observability-kafka
  part_of_label: observability
  otel_collector_image: otel/opentelemetry-collector-contrib:0.109.0
  loki_image: grafana/loki:3.0.0
  grafana_image: grafana/grafana:11.3.0
  otel_webhook:
    alertmanager_username: aiops-alertmanager
    alertmanager_password: <your-alertmanager-webhook-password>
    itsm_username: aiops-itsm-webhook
    itsm_password: <your-itsm-webhook-password>
  grafana:
    admin_user: admin
    admin_password: "{{ demo_admin_password }}"
    session_duration: 1h
    host: "grafana-observability.apps.{{ ocp_host }}"

aap_casc:
  namespace: aap
  instance_name: ansible
  organization: AIOps
  validate_certs: false
  aiops_demo_namespace: aiops-demo
  controller_api_prefix: /api/controller/
  gitops_instance_name: openshift-gitops
  enable_observability_pipelines: true
  # EDA consumes aiops.itsm and POSTs to agent.incidents_url (no chat app).
  itsm_chat_webhook_delivery: eda
  public_ah_token: <your-red-hat-automation-hub-offline-token>
