---
# Copy to vars.yaml and replace every <...> placeholder.
#   cp vars.yaml.example vars.yaml
#
# Do not commit vars.yaml (it is gitignored).
# Cluster credentials: pass ocp_host and api_token at runtime with -e, not here.

# Standard demo admin password for Argo CD, ITSM, Grafana, and Gitea.
demo_admin_password: redhat1q2w3e

kubeconfig:
  ocp_domain: "{{ ocp_host }}"
  ocp_api_token: "{{ api_token }}"

openshift_mcp:
  namespace: openshift-mcp

aap_mcp:
  namespace: aap
  instance_name: ansible
  allow_write_operations: true
  ignore_certificate_errors: true
  port: 8086
  url: ""
  token: ""
  token_description: aiops-mcp-agent
  token_scope: write
  token_secret_name: aap-mcp-agent-token
  validate_certs: false

aap_eda:
  namespace: aap
  instance_name: ansible
  automation_server_ssl_verify: "no"
  postgres_pod_label_selector: app.kubernetes.io/name=postgres-15,app.kubernetes.io/part-of=ansible
  postgres_admin_secret: ansible-gateway-postgres-configuration
  postgres_admin_password_key: postgres_admin_password
  database_name: eda
  database_owner: eda

gitops:
  namespace: openshift-gitops
  instance_name: openshift-gitops
  admin_user: admin
  admin_password: "{{ demo_admin_password }}"
  session_duration: 1h

itsm:
  namespace: itsm-app
  image: quay.io/rhn_support_rafsanch/itsm-app:v2.1
  session_secret: <replace-with-long-random-string>
  mcp_token: <your-itsm-mcp-token>
  bootstrap_admin_user: admin
  bootstrap_admin_password: "{{ demo_admin_password }}"
  seed_aiops_password: "{{ demo_admin_password }}"
  session_max_age_seconds: 3600
  embedding_base_url: <your-embedding-api-base-url>
  embedding_model: <your-embedding-model>
  embedding_api_key: <your-embedding-api-key>
  kb_repo_url: https://github.com/clbartolome/redhat-aiops-ecosystem
  kb_repo_path: components/itsm/kbs

gitea:
  namespace: gitea
  host: "gitea-gitea.apps.{{ ocp_host }}"
  root_url: "https://gitea-gitea.apps.{{ ocp_host }}/"
  gitea_image: quay.io/rhn_support_rafsanch/gitea:1.24-rootless
  postgres_image: quay.io/rhn_support_rafsanch/postgres:16-alpine
  secret_key: <openssl-rand-hex-32>
  admin_user: giteaadmin
  admin_password: "{{ demo_admin_password }}"
  admin_email: admin@example.com
  session_max_age_seconds: 3600
  postgres_user: gitea
  postgres_password: <your-postgres-password>
  postgres_db: gitea

agent:
  namespace: aiops-tools
  image: quay.io/calopezb/gen-ai-k8s-playground-agent
  llm_url: <your-llm-url>
  llm_api_key: <your-llm-api-key>
  llm_model: <your-llm-model>
  llm_timeout: 150
  tools_timeout: 60
  ssl_verify: false
  log_level: INFO
  trace_db_path: /tmp/agent-traces.db
  openshift_mcp_url: http://openshift-mcp-server.{{ openshift_mcp.namespace }}.svc:8080/mcp/
  aap_mcp_url: "{{ aap_mcp.url | default('http://' ~ aap_mcp.instance_name ~ '-mcp.' ~ aap_mcp.namespace ~ '.svc:' ~ (aap_mcp.port | default(8086) | string) ~ '/mcp/', true) }}"
  aap_mcp_token: "{{ aap_mcp.token }}"
  itsm_mcp_url: http://itsm-app.{{ itsm.namespace }}.svc:8000/mcp/
  itsm_mcp_token: "{{ itsm.mcp_token }}"

chat:
  namespace: "{{ agent.namespace }}"
  image: quay.io/calopezb/gen-ai-k8s-playground-chat
  ssl_verify: false
  log_level: INFO
  trace_db_path: /tmp/agent-traces.db
  agent_url: http://agent.{{ agent.namespace }}.svc:8080
  agent_timeout: 120

monitor:
  namespace: "{{ agent.namespace }}"
  image: quay.io/calopezb/gen-ai-k8s-playground-monitor
  ssl_verify: false
  log_level: INFO
  trace_db_path: /tmp/agent-traces.db
  agent_url: http://agent.{{ agent.namespace }}.svc:8080
  agent_timeout: 120

observability:
  namespace: observability
  kafka_cluster_name: observability-kafka
  part_of_label: observability
  otel_collector_image: otel/opentelemetry-collector-contrib:0.109.0
  loki_image: grafana/loki:3.0.0
  grafana_image: grafana/grafana:11.3.0
  otel_webhook:
    alertmanager_username: aiops-alertmanager
    alertmanager_password: <your-alertmanager-webhook-password>
    itsm_username: aiops-itsm-webhook
    itsm_password: <your-itsm-webhook-password>
  grafana:
    admin_user: admin
    admin_password: "{{ demo_admin_password }}"
    session_duration: 1h
    host: "grafana-observability.apps.{{ ocp_host }}"

aap_casc:
  namespace: aap
  instance_name: ansible
  organization: AIOps
  validate_certs: false
  aiops_demo_namespace: aiops-demo
  controller_api_prefix: /api/controller/
  gitops_instance_name: openshift-gitops
  enable_observability_pipelines: true
  itsm_chat_webhook_delivery: eda
  public_ah_token: <your-red-hat-automation-hub-offline-token>
